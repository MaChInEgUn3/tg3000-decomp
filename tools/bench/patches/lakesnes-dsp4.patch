 static uint8_t cart_readLorom(Cart* cart, uint8_t bank, uint16_t adr);
 static void cart_writeLorom(Cart* cart, uint8_t bank, uint16_t adr, uint8_t val);
@@ -17,6 +18,8 @@ static uint8_t cart_readExHirom(Cart* cart, uint8_t bank, uint16_t adr);
 static void cart_writeHirom(Cart* cart, uint8_t bank, uint16_t adr, uint8_t val);
 static uint8_t cart_readCX4(Cart* cart, uint8_t bank, uint16_t adr);
 static void cart_writeCX4(Cart* cart, uint8_t bank, uint16_t adr, uint8_t val);
+static uint8_t cart_readDsp4(Cart* cart, uint8_t bank, uint16_t adr);
+static void cart_writeDsp4(Cart* cart, uint8_t bank, uint16_t adr, uint8_t val);
 
 Cart* cart_init(Snes* snes) {
   Cart* cart = malloc(sizeof(Cart));
@@ -43,6 +46,9 @@ void cart_reset(Cart* cart) {
       cx4_init(cart->snes);
       cx4_reset();
       break;
+    case 0x05:
+      dsp4_bridge_reset();
+      break;
   }
 }
 
@@ -109,6 +115,7 @@ uint8_t cart_read(Cart* cart, uint8_t bank, uint16_t adr) {
     case 2: return cart_readHirom(cart, bank, adr);
     case 3: return cart_readExHirom(cart, bank, adr);
     case 4: return cart_readCX4(cart, bank, adr);
+    case 5: return cart_readDsp4(cart, bank, adr);
   }
   return cart->snes->openBus;
 }
@@ -120,6 +127,7 @@ void cart_write(Cart* cart, uint8_t bank, uint16_t adr, uint8_t val) {
     case 2: cart_writeHirom(cart, bank, adr, val); break;
     case 3: cart_writeHirom(cart, bank, adr, val); break;
     case 4: cart_writeCX4(cart, bank, adr, val); break;
+    case 5: cart_writeDsp4(cart, bank, adr, val); break;
   }
 }
 
@@ -209,3 +217,21 @@ static void cart_writeHirom(Cart* cart, uint8_t bank, uint16_t adr, uint8_t val)
     cart->ram[(((bank & 0x3f) << 13) | (adr & 0x1fff)) & (cart->ramSize - 1)] = val;
   }
 }
+
+// DSP-4 (Top Gear 3000): banks 30-3f and b0-bf, data at 8000-bfff, status at c000-ffff.
+// The data register at $30:8000 is the address the game itself uses (560 static long
+// accesses in the ROM); the status half follows the DSP-1 LoROM layout.
+static uint8_t cart_readDsp4(Cart* cart, uint8_t bank, uint16_t adr) {
+  if((bank & 0x7f) >= 0x30 && (bank & 0x7f) < 0x40 && adr >= 0x8000) {
+    return dsp4_bridge_read(bank, adr);
+  }
+  return cart_readLorom(cart, bank, adr);
+}
+
+static void cart_writeDsp4(Cart* cart, uint8_t bank, uint16_t adr, uint8_t val) {
+  if((bank & 0x7f) >= 0x30 && (bank & 0x7f) < 0x40 && adr >= 0x8000) {
+    dsp4_bridge_write(bank, adr, val);
+    return;
+  }
+  cart_writeLorom(cart, bank, adr, val);
+}
